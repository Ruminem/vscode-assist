{
  "name": "vscode-assist",
  "displayName": "Assist — Navigation Keys",
  "description": "Navigation shortcuts VS Code does not ship, bound to keys VS Code does not use.",
  "version": "0.4.3",
  "publisher": "Ruminem",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruminem/vscode-assist.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "keywords": ["goto definition", "declaration", "navigation", "shortcuts", "c++"],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "scripts": {
    "check-keys": "node tools/check-keys.js",
    "icon": "node tools/make-icon.js",
    "release": "node tools/release.js"
  },
  "contributes": {
    "commands": [
      { "command": "assist.roundTrip", "title": "%command.roundTrip.title%" },
      { "command": "assist.roundTrip.explain", "title": "%command.explain.title%" },
      { "command": "assist.nextFunction", "title": "%command.nextFunction.title%" },
      { "command": "assist.previousFunction", "title": "%command.previousFunction.title%" },
      { "command": "assist.searchSymbols", "title": "%command.searchSymbols.title%" },
      { "command": "assist.attachToProcess", "title": "%command.attachToProcess.title%" },
      { "command": "assist.reattachToProcess", "title": "%command.reattachToProcess.title%" }
    ],
    "keybindings": [
      {
        "command": "assist.roundTrip",
        "key": "alt+g",
        "when": "editorTextFocus && editorHasDefinitionProvider && config.assist.keymap.enabled"
      },
      {
        "command": "assist.roundTrip",
        "key": "alt+d",
        "when": "editorTextFocus && editorHasDefinitionProvider && config.assist.keymap.enabled"
      },
      {
        "command": "assist.searchSymbols",
        "key": "shift+alt+s",
        "when": "config.assist.keymap.enabled"
      },
      {
        "command": "workbench.action.gotoSymbol",
        "key": "alt+m",
        "when": "editorTextFocus && config.assist.keymap.enabled"
      },
      {
        "command": "workbench.action.quickOpen",
        "key": "shift+alt+o",
        "when": "config.assist.keymap.enabled"
      },
      {
        "command": "editor.action.organizeImports",
        "key": "shift+alt+o",
        "when": "config.assist.keymap.enabled && textInputFocus && !editorReadonly && supportedCodeAction =~ /(\\s|^)source\\.organizeImports\\b/"
      },
      {
        "command": "assist.nextFunction",
        "key": "ctrl+shift+down",
        "when": "editorTextFocus && editorHasDocumentSymbolProvider && !isLinux && config.assist.keymap.enabled"
      },
      {
        "command": "assist.previousFunction",
        "key": "ctrl+shift+up",
        "when": "editorTextFocus && editorHasDocumentSymbolProvider && !isLinux && config.assist.keymap.enabled"
      },
      {
        "command": "assist.attachToProcess",
        "key": "ctrl+alt+p",
        "when": "isWindows && config.assist.keymap.enabled"
      },
      {
        "command": "assist.reattachToProcess",
        "key": "shift+alt+p",
        "when": "isWindows && config.assist.keymap.enabled"
      }
    ],
    "configuration": [
      {
        "title": "%config.title%",
        "properties": {
          "assist.keymap.enabled": {
            "type": "boolean",
            "default": true,
            "order": 0,
            "markdownDescription": "%config.keymap.enabled%"
          }
        }
      },
      {
        "title": "%config.roundTrip.title%",
        "properties": {
          "assist.roundTrip.providers": {
            "type": "array",
            "default": ["definition", "implementation", "declaration"],
            "items": {
              "type": "string",
              "enum": ["definition", "declaration", "implementation", "typeDefinition"]
            },
            "uniqueItems": true,
            "order": 0,
            "markdownDescription": "%config.roundTrip.providers%"
          },
          "assist.roundTrip.searchByName": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "markdownDescription": "%config.roundTrip.searchByName%"
          },
          "assist.roundTrip.pickWhenAmbiguous": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "markdownDescription": "%config.roundTrip.pickWhenAmbiguous%"
          },
          "assist.roundTrip.textSearch": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "markdownDescription": "%config.roundTrip.textSearch%"
          }
        }
      },
      {
        "title": "%config.symbolSearch.title%",
        "properties": {
          "assist.symbolSearch.fuzzy": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.symbolSearch.fuzzy%"
          }
        }
      }
    ]
  }
}
